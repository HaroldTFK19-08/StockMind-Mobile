# Copia este archivo como .env y reinicia con: npx expo start --clear
#
# ── URL base de la API (sin "/" al final) ─────────────────────────────────
# Las rutas de src/core/api/endpoints.js se agregan detrás (ej: /centros).
# NUNCA uses "localhost" pensando en el celular: ahí localhost es el propio celular.
#
#   XAMPP/Apache apuntando a la carpeta public:  http://<IP-del-PC>/v1
#   php artisan serve:                           http://<IP-del-PC>:8000/api/v1
#     (arráncalo con: php artisan serve --host=0.0.0.0 --port=8000)
#   Servidor publicado:                          https://api.midominio.com/api/v1
#
# Saca la IP del PC con "ipconfig" (Adaptador Wi-Fi → Dirección IPv4).
# El celular y el PC deben estar en la misma red Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.20.63/v1

# ── ¿De dónde salen los datos? ────────────────────────────────────────────
# false = TODOS los módulos consumen la API.
# true  = modo demo (datos en memoria), excepto los módulos de EXPO_PUBLIC_API_MODULES.
EXPO_PUBLIC_USE_MOCKS=true

# Módulos que ya existen en Laravel, separados por coma (solo aplica si USE_MOCKS=true).
# Opciones: dashboard, usuarios, centros, ambientes, elementos,
#           asignaciones, traslados, reportes, notificaciones   ( * = todos )
# El login (auth) es local: Laravel todavía no tiene autenticación.
EXPO_PUBLIC_API_MODULES=centros

# Tiempo máximo de espera por petición, en milisegundos (1000 - 120000)
EXPO_PUBLIC_API_TIMEOUT=15000

# true = muestra en la consola de Metro cada petición y respuesta (solo desarrollo)
EXPO_PUBLIC_API_DEBUG=true
