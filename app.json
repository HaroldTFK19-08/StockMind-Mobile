{
  "expo": {
    "name": "StockMind",
    "slug": "StockMind",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stockmind",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#39A900",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "StockMind necesita acceso a tus fotos para adjuntarlas a los registros.",
          "cameraPermission": "StockMind necesita acceso a la cámara para tomar fotos y adjuntarlas a los registros.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
